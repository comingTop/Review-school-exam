{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/lib/quiz-questions": ["harness/quiz-questions.ts"] }
  },
  "include": ["provas/**/*.tsx", "tools/**/*.ts", "harness/**/*.ts"]
}
